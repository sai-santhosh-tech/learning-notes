13) Write a query to find the First and Last record for each employee based on the 'hire_date' column
WITH RankedEmployees AS (
    SELECT *, 
           ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY hire_date ASC) AS rn_first,
           ROW_NUMBER() OVER (PARTITION BY employee_id ORDER BY hire_date DESC) AS rn_last
    FROM employee
)
SELECT employee_id, name, hire_date
FROM RankedEmployees
WHERE rn_first = 1 OR rn_last = 1
ORDER BY employee_id, hire_date;


14) Customer(customer_id, name) 
Orders(order_id, customer_id, order_date, amount)
Write a query to find the top 3 customers by toatl order amount in the last 30 days, returning : customer_id, name, total_amount

Select cus.customer_id, cus.name, sum(ord.amount) as total_amount from customer cus inner join orders ord on cus.cutomer_id = ord.customer_id
where ord.order_date >= sysdate - 30
group by cus.customer_id, cus.customer_name
order by total_amount desc
limit 3;


